# PostgreSQL bağlantısı
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brokerage

# Sunucu portu
PORT=4000

# Veri yenileme aralığı (dakika). 0 = otomatik yenileme kapalı
REFRESH_INTERVAL_MINUTES=30

# Sohbet asistanı (Claude API). Boşsa /api/chat 503 döner, siteki chat sekmesi
# "şu an devre dışı" gösterir — geri kalan site normal çalışır.
ANTHROPIC_API_KEY=
# Model — daha yüksek kaliteli yanıt isterseniz claude-opus-5 yapabilirsiniz.
CHAT_MODEL=claude-sonnet-5
# IP başına hız sınırı (kötüye kullanım/masraf koruması)
CHAT_RATE_LIMIT=12
CHAT_RATE_WINDOW_MINUTES=5
